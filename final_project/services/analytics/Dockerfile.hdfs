FROM python:3.12-slim

WORKDIR /app

COPY services/analytics/requirements.txt /app/requirements.txt

RUN pip install \
    --no-cache-dir \
    -r /app/requirements.txt

COPY services/analytics/hdfs_consumer.py /app/hdfs_consumer.py
COPY services/analytics/publish_recommendations.py /app/publish_recommendations.py

CMD ["python", "/app/hdfs_consumer.py"]